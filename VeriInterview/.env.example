# Set to a real provider name ("openai", "anthropic", etc.) and supply LLM_API_KEY to
# enable real AI question/reference-answer generation. Leave as "none" to run fully
# offline — the synthetic demo dataset does not require an LLM at all.
LLM_PROVIDER=none
LLM_API_KEY=

# Audio inference is offline after an explicit scripts/download_audio_model.py run.
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_ALLOW_DOWNLOAD=0
# Optional: absolute path to the model cache (default storage/models).
# WHISPER_CACHE_DIR=
