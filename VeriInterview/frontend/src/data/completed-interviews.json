          "question_text": "What is overfitting in machine learning and how do you detect it?",
          "skill": "Machine Learning",
          "difficulty": "Basic",
          "expected_proficiency": "Intermediate",
          "reference_answer": "Overfitting occurs when a model learns the training data too closely, including noise, and therefore generalizes poorly to unseen data. It can be detected via a gap between training and validation/test performance.",
          "required_concepts": [
            "training data",
            "noise",
            "generalization",
            "unseen data",
            "validation"
          ],
          "candidate_answer": "Overfitting happens when a model memorizes the training data, including its noise, so it performs great on training data but poorly on unseen validation or test data. You usually catch it by watching the gap between training and validation loss.",
          "response_latency_sec": 1.8,
          "answer_duration_sec": 40.0
        },
        {
          "question_id": "Q2",
          "question_text": "Describe how you deployed a system on AWS. What services did you use?",
          "skill": "AWS",
          "difficulty": "Intermediate",
          "expected_proficiency": "Advanced",
          "reference_answer": "A strong answer describes EC2 for compute, S3 for storage, Lambda for event-driven functions, IAM for access control, and auto-scaling/load balancers for reliability.",
          "required_concepts": [
            "EC2",
            "S3",
            "Lambda",
            "IAM",
            "auto-scaling",
            "load balancer"
          ],
          "candidate_answer": "I deployed the recommendation service on EC2 behind a load balancer, used auto-scaling to handle traffic spikes, stored artifacts in S3, ran event-driven feature updates with Lambda, and scoped access with IAM roles per service.",
          "response_latency_sec": 2.1,
          "answer_duration_sec": 55.0
        },
        {
          "question_id": "Q3",
          "question_text": "How would you handle an imbalanced dataset when training a classifier?",
          "skill": "Machine Learning",
          "difficulty": "Intermediate",
          "expected_proficiency": "Advanced",
          "reference_answer": "Techniques include resampling (oversampling minority/undersampling majority), class weighting, using appropriate metrics like F1 or PR-AUC instead of accuracy, and algorithms such as XGBoost with scale_pos_weight.",
          "required_concepts": [
            "resampling",
            "class weight",
            "F1",
            "precision",
            "recall",
            "XGBoost"
          ],
          "candidate_answer": "I'd use resampling \u2014 oversampling the minority class or undersampling the majority \u2014 and switch to class weighting in the loss. I'd also stop trusting accuracy and use F1 or PR-AUC instead. XGBoost's scale_pos_weight handles this natively.",
          "response_latency_sec": 2.4,
          "answer_duration_sec": 60.0
        },
        {
          "question_id": "Q4",
          "question_text": "What is the difference between a load balancer and auto-scaling group on AWS?",
          "skill": "AWS",
          "difficulty": "Basic",
          "expected_proficiency": "Intermediate",
          "reference_answer": "A load balancer distributes incoming traffic across multiple instances, while an auto-scaling group automatically adds or removes instances based on demand.",
          "required_concepts": [
            "load balancer",
            "auto-scaling",
            "traffic distribution",
            "demand"
          ],
          "candidate_answer": "A load balancer distributes incoming traffic across healthy instances, while an auto-scaling group changes the number of instances based on demand.",
